# JWT tokenlarni imzolash uchun maxfiy kalit (foydalanuvchi login qilganda
# beriladigan token shu kalit bilan imzolanadi). Uzun, tasodifiy qator bo'lishi kerak.
# E'TIBOR: buni o'zingiz qo'lda yozishingiz shart emas — deploy.sh birinchi marta
# ishga tushganda .env faylini shu misoldan yaratadi va JWT_SECRET'ni avtomatik
# tasodifiy qiymat bilan to'ldiradi. Shunchaki deploy.sh'ni ishga tushiring.
JWT_SECRET=change_this_to_a_long_random_secret

# Backend serveringiz tashqariga qaysi portda ochilishi (VPS'da shu port ochiq
# bo'lishi kerak). VPS'da boshqa loyihalar band qilgan portlar bilan
# to'qnashmasligi uchun standart qiymat 4010 qilib qo'yilgan (4000, 4001, 4002,
# 4200 kabi portlar boshqa konteynerlar tomonidan band).
SERVER_PORT=4010
